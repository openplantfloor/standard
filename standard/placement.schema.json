{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.openplantfloor.org/standard/placement.schema.json",
  "title": "Placement",
  "version": "0.1.0",
  "description": "Where equipment stands: a frame -- a floor or a cell -- with its origin and extent, and each piece of equipment positioned and turned in it. Each position is the equipment's footprint origin in the frame, each coordinate a length; each turn is a yaw about the frame's vertical axis. A placement is one possible layout; an alternative layout is another placement record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "placementId",
    "frame",
    "placed"
  ],
  "properties": {
    "$schema": {
      "const": "https://schemas.openplantfloor.org/standard/placement.schema.json"
    },
    "placementId": {
      "$ref": "https://schemas.openplantfloor.org/standard/common.schema.json#/definitions/identifier"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "floor",
            "cell"
          ]
        },
        "scopeRef": {
          "$ref": "https://schemas.openplantfloor.org/standard/common.schema.json#/definitions/identifier",
          "description": "The floor's site or the cell's equipment record."
        },
        "origin": {
          "type": "string",
          "minLength": 1,
          "description": "Where the frame's origin and x axis lie, in words: for example the north-west column, x along the north wall."
        },
        "extent": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "length",
            "width"
          ],
          "properties": {
            "length": {
              "$ref": "https://schemas.openplantfloor.org/standard/common.schema.json#/definitions/length"
            },
            "width": {
              "$ref": "https://schemas.openplantfloor.org/standard/common.schema.json#/definitions/length"
            },
            "height": {
              "$ref": "https://schemas.openplantfloor.org/standard/common.schema.json#/definitions/length"
            }
          }
        }
      }
    },
    "placed": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/placed"
      }
    },
    "evidence": {
      "$ref": "https://schemas.openplantfloor.org/standard/common.schema.json#/definitions/evidence"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.openplantfloor.org/standard/common.schema.json#/definitions/source"
      }
    }
  },
  "definitions": {
    "placed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "equipmentRef",
        "position"
      ],
      "properties": {
        "equipmentRef": {
          "$ref": "https://schemas.openplantfloor.org/standard/common.schema.json#/definitions/identifier",
          "description": "The equipment record placed."
        },
        "position": {
          "$ref": "https://schemas.openplantfloor.org/standard/common.schema.json#/definitions/position"
        },
        "yaw": {
          "$ref": "https://schemas.openplantfloor.org/standard/common.schema.json#/definitions/yaw"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
